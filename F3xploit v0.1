local function C_12()
	local script = G2L["LocalScript_12"];
	local TweenService = game:GetService("TweenService")	
	
	local ui = script.Parent	
	local rotationAmount = 5	
	local tweenTime = 1.5	
	
	while true do	
		local tween1 = TweenService:Create(ui, TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Rotation = rotationAmount})	
		tween1:Play()	
		tween1.Completed:Wait()	
			
		local tween2 = TweenService:Create(ui, TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Rotation = -rotationAmount})	
		tween2:Play()	
		tween2.Completed:Wait()	
	end	
end;
