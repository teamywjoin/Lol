local player = game.Players.LocalPlayer

local function setTpose()
    local character = player.Character or player.CharacterAdded:Wait()
    local torso = character:FindFirstChild("Torso")
    if not torso then return end

    local leftShoulder = torso:FindFirstChild("Left Shoulder")
    local rightShoulder = torso:FindFirstChild("Right Shoulder")
    if not leftShoulder or not rightShoulder then return end

    -- Remove any offset (reset to default joint configuration)
    -- Then add only Z axis rotation
    local origLeftC0 = leftShoulder.C0
    local origRightC0 = rightShoulder.C0

    -- Z axis rotation 90 degrees (shoulder height for T-pose)
    local angle = math.pi / 2

    -- For R6 T-pose, rotate about Z axis only at default position!
    leftShoulder.C0 = CFrame.new(-1.5, 0.5, -0.5) * CFrame.Angles(0, 0, -angle)
    rightShoulder.C0 = CFrame.new(1.5, 0.5, -0.5) * CFrame.Angles(0, 0, angle)
end

setTpose()
