local function C_b()
	local script = LMG2L["LocalScript_b"];
	local Players = game:GetService("Players")	
	local ReplicatedStorage = game:GetService("ReplicatedStorage")	
	local localPlayer = Players.LocalPlayer	
	
	local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent	
	
	local function getTargets(arg)	
		arg = arg:lower()	
	
		if arg == "me" then	
			return { localPlayer }	
		elseif arg == "all" then	
			return Players:GetPlayers()	
		elseif arg == "others" then	
			local list = {}	
			for _, plr in ipairs(Players:GetPlayers()) do	
				if plr ~= localPlayer then	
					table.insert(list, plr)	
				end	
			end	
			return list	
		else	
			local result = {}	
			for _, plr in ipairs(Players:GetPlayers()) do	
				if plr.Name:lower():sub(1, #arg) == arg then	
					table.insert(result, plr)	
				end	
			end	
			return result	
		end	
	end	
	
	localPlayer.Chatted:Connect(function(msg)	
		local args = string.split(msg, " ")	
		local command = args[1]	
		local targetArg = args[2]	
	
		if command == "re" then	
			if not targetArg then	
				warn("pls chat player. (me / all / others / player)")	
				return	
			end	
	
			local targets = getTargets(targetArg)	
	
			if #targets == 0 then	
				warn("is not player:", targetArg)	
				return	
			end	
	
			for _, plr in ipairs(targets) do	
				print(plr.Name .. "re")	
				RequestCommand:InvokeServer(";re " .. plr.Name)	
			end	
		end	
	end)	
end;
task.spawn(C_b);
