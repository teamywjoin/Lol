local function C_7()
local script = LMG2L["LocalScript_7"];
local textLabel = script.Parent	
local player = game.Players.LocalPlayer

local RunService = game:GetService("RunService")	  
  
-- 처음에는 숨김	  
textLabel.Visible = false	  
  
-- FPS 계산 변수	  
local lastTime = tick()	  
local fps = 0	  
  
RunService.RenderStepped:Connect(function()	  
    local now = tick()	  
    fps = 1 / (now - lastTime)	  
    lastTime = now	  
end)	  
  
  
player.Chatted:Connect(function(msg)	  
    msg = msg:lower()	  
  
    if msg == "ping" then	  
        textLabel.Visible = true	  
        textLabel.Text = "FPS : wait.."	  
        	  
        -- FPS 값을 지속적으로 갱신	  
        task.spawn(function()	  
            while textLabel.Visible do	  
                textLabel.Text = "FPS : " .. math.floor(fps)	  
                task.wait(0.1)	  
            end	  
        end)	  
    end	  
  
    if msg == ":unping" then	  
        textLabel.Visible = false	  
    end	  
end)

end;
task.spawn(C_7);

